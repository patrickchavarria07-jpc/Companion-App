{
  "name": "research-buddy",
  "version": "1.0.0",
  "description": "A floating desktop research companion",
  "author": "Research Buddy",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "clean": "node -e \"for (const dir of ['dist', 'dist-electron']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "predev": "npm run clean",
    "dev": "concurrently -k -n vite,tsc,app -c blue,yellow,green \"vite --configLoader runner --host 127.0.0.1 --port 5173 --strictPort\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on http-get://127.0.0.1:5173 file:dist-electron/electron/main.js file:dist-electron/electron/preload.js && nodemon\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run clean && npm run typecheck && tsc -p tsconfig.electron.json && vite build --configLoader runner",
    "prestart": "npm run build",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "app.researchbuddy.desktop",
    "productName": "Research Buddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
