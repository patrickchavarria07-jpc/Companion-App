{
  "name": "research-buddy",
  "version": "1.0.0",
  "description": "A floating desktop research companion",
  "author": "Research Buddy",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && concurrently -k \"vite --configLoader runner --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http-get://127.0.0.1:5173 && electron . --dev\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && tsc -p tsconfig.electron.json && vite build --configLoader runner",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "app.researchbuddy.desktop",
    "productName": "Research Buddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
